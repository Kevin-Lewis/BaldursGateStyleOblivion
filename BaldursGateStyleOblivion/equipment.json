    },
    {
      "Name": "Marauders",
      "Match": "ActorCategory=Marauder|MarauderFaction",
      "Profile": "Professional",
      "Reason": "Professional armor, with high materials uncommon."
    },
    {
      "Name": "Upper class",
      "Match": "UpperClass|Noble|Countess|Count[^a-z]",
      "Profile": "HighQuality",
      "Reason": "Status permits better equipment without raising combat tier."
    },
    {
