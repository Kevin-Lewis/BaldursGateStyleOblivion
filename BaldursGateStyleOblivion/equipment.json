    {
      "Name": "High-ranking Dremora",
      "Match": "^(?:[^|]*(?:Markynaz|Valkynaz)[^|]*|MQ15(?:Kathutet|Orthe|Ranyu))(?= \\||$)",
      "Profile": "HighDremora",
